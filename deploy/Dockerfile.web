FROM node:24-alpine AS construccion

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/api/package.json packages/api/package.json
COPY packages/dominio/package.json packages/dominio/package.json
COPY packages/panel/package.json packages/panel/package.json
COPY packages/portal/package.json packages/portal/package.json
RUN npm ci

COPY packages/dominio packages/dominio
COPY packages/panel packages/panel
COPY packages/portal packages/portal
RUN npm run build --workspace @simce/panel && npm run build --workspace @simce/portal

FROM nginx:1.29-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=construccion /app/packages/portal/dist /usr/share/nginx/html
COPY --from=construccion /app/packages/panel/dist /usr/share/nginx/html/panel

EXPOSE 80
