{
  "name": "simce-mcye",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node scripts/compilar.mjs",
    "test": "node scripts/verificar.mjs pruebas",
    "test:coverage": "node scripts/verificar.mjs cobertura",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/verificar.mjs",
    "check:repo": "node scripts/verificar-repositorio.mjs",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crear-base-datos-local.ps1",
    "prototype": "node scripts/prototipo-fase-cero.mjs",
    "dev:fase1": "node scripts/iniciar-fase-uno.mjs",
    "check:fase1": "node scripts/verificar-fase-uno.mjs",
    "check:fase2": "node scripts/verificar-fase-dos.mjs",
    "check:fase3": "node scripts/verificar-fase-tres.mjs",
    "check:mysql-local": "node scripts/verificar-mysql-local.mjs",
    "backup:local": "node scripts/respaldo-mysql.mjs",
    "dev:api": "npm run dev --workspace @simce/api",
    "dev:panel": "npm run dev --workspace @simce/panel",
    "dev:portal": "npm run dev --workspace @simce/portal"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "chrome-launcher": "1.2.2",
    "eslint": "10.10.0",
    "globals": "17.4.0",
    "lighthouse": "13.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.0",
    "vitest": "5.0.5"
  }
}
