NODE_ENV=development
HOST=127.0.0.1
PORT=3000
STORAGE=memory
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=simce
DATABASE_USER=simce
DATABASE_PASSWORD=REEMPLAZAR_EN_ENTORNO_LOCAL
DATABASE_ROOT_PASSWORD=REEMPLAZAR_EN_ENTORNO_LOCAL
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LOCAL
CMS_ORIGENES=http://127.0.0.1:8080,http://localhost:8080
# Solo configurar con el aviso de privacidad autorizado para contactos de interés.
AVISO_INTERES_URL=
AVISO_INTERES_VERSION=
VITE_API_URL=http://127.0.0.1:3000/api/v1
HTTP_PORT=8080
# Recuperación local: los mensajes se guardan en CMS_DIR/correos, sin envío externo.
CORREO_MODO=archivo
# En producción usar HTTPS y correo SMTP con TLS; no incluir secretos reales aquí.
PANEL_ORIGEN_PUBLICO=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
