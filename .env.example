NODE_ENV=development
HOST=127.0.0.1
PORT=3000
STORAGE=memory
# Perfil de prueba EAN-13 si las variables de báscula quedan vacías.
BASCULA_VERSION=
BASCULA_PREFIJO=
BASCULA_PLU_DIGITOS=
BASCULA_IMPORTE_DIGITOS=
BASCULA_RESOLUCION_GRAMOS=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=simce
DATABASE_USER=simce
DATABASE_PASSWORD=REEMPLAZAR_EN_ENTORNO_LOCAL
DATABASE_ROOT_PASSWORD=REEMPLAZAR_EN_ENTORNO_LOCAL
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LOCAL
CMS_ORIGENES=http://127.0.0.1:8080,http://localhost:8080
# Aviso vigente: usar la ruta /privacidad/simce-2026-11-06-v5.html
# y la versión simce-2026-11-06-v5 para habilitar cada formulario.
# Vaciar URL y versión juntas deshabilita ese formulario.
AVISO_INTERES_URL=
AVISO_INTERES_VERSION=
# El recurso relativo se sirve en el mismo origen HTTPS del portal institucional.
AVISO_TALLERES_URL=
AVISO_TALLERES_VERSION=
VITE_API_URL=http://127.0.0.1:3000/api/v1
HTTP_PORT=8080
# Correo local: recuperación y copias de consultas en CMS_DIR/correos, sin envío externo.
CORREO_MODO=archivo
# En producción usar HTTPS y correo SMTP con TLS; no incluir secretos reales aquí.
PANEL_ORIGEN_PUBLICO=http://127.0.0.1:3000
# Origen del portal usado en el botón de los correos de consulta.
PORTAL_ORIGEN_PUBLICO=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
